# Copy to .env.local and adjust. VITE_* variables are validated when `pnpm dev` or
# `pnpm build` starts and again in the browser (src/app/parseAppConfig.ts).
# VITE_* values are inlined into the public JavaScript bundle: never put secrets here.

# Page title shown in the browser tab. Non-empty string. Default: Floor
VITE_APP_TITLE=Floor

# Show the Leva debug panel in development builds. "true" or "false". Default: false
VITE_DEBUG_PANEL=true

# Server ports are NOT read from .env files: export them in the shell instead,
# e.g. `DEV_SERVER_PORT=5199 pnpm dev`. Each must be an integer from 1 to 65535.
#   DEV_SERVER_PORT      dev server (pnpm dev), default 5173
#   PREVIEW_SERVER_PORT  preview server (pnpm preview), default 4173
#   E2E_SERVER_PORT      preview server started by pnpm test:e2e, default 4174
